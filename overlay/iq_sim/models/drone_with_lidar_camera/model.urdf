<?xml version="1.0"?>
<robot name="drone_with_lidar_camera">
    <!-- Dummy link to avoid KDL issue -->
    <link name="dummy_link">
      <inertial>
        <mass value="0.0001"/>
        <inertia ixx="0.00001" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.00001"/>
      </inertial>
    </link>
  
    <joint name="dummy_joint" type="fixed">
      <parent link="dummy_link"/>
      <child link="base_link"/>
    </joint>
  
    <!-- Original URDF content -->
    <link name="base_link">
      <!-- Original inertial parameters -->
      <inertial>
        <mass value="1.0"/>
        <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
      </inertial>
    </link>
  
    <!-- The rest of your URDF links and joints go here -->

  <!-- Camera link -->
  <link name="cam_link">
    <inertial>
      <mass value="0.01" />
      <origin xyz="0 0 -0.02" />
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001" />
    </inertial>
    <visual>
      <origin xyz="0 0 0.15" rpy="0 -1.57 0" />
      <geometry>
        <cylinder radius="0.005" length="0.018" />
      </geometry>
    </visual>
  </link>

  <joint name="camera_mount" type="fixed">
    <parent link="base_link" />
    <child link="cam_link" />
    <origin xyz="0 0 -0.02" />
  </joint>

  <!-- Hokuyo link -->
  <link name="hokuyo_link">
    <inertial>
      <mass value="0.016" />
      <origin xyz="0 0 0" />
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001" />
    </inertial>
    <visual>
      <origin xyz="0 0 0.27" />
      <geometry>
        <mesh filename="package://hokuyo/meshes/hokuyo.dae" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0.3" />
      <geometry>
        <box size="0.1 0.1 0.1" />
      </geometry>
    </collision>
  </link>

  <joint name="hokuyo_joint" type="fixed">
    <parent link="base_link" />
    <child link="hokuyo_link" />
    <origin xyz="0 0 0" />
  </joint>

</robot>
