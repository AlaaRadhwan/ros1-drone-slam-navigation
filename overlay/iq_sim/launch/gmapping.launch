<launch>

    <node pkg="gmapping" type="slam_gmapping" name="slam_gmapping">
      <param name="base_frame" value="base_link" />
      <!-- <param name="odom_frame" value="odom" /> -->
      <param name="map_frame" value="map" />
      <param name="linearUpdate" value="0.2" />
      <param name="angularUpdate" value="0.2" />
      <param name="temporalUpdate" value="1.0" />
      <param name="resampleThreshold" value="0.5" />
      <param name="particles" value="80" />
      <remap from="scan" to="/spur/laser/scan"/>

    </node>  

      <!-- Static transform from base_link to hokuyo_link -->
    <node pkg="tf2_ros" type="static_transform_publisher" name="base_to_hokuyo" args="0 0 0.3 0 0 0 base_link hokuyo_link" />

    <!-- Static transform from hokuyo_link to hokuyo_sensor_link -->
    <node pkg="tf2_ros" type="static_transform_publisher" name="hokuyo_to_sensor" args="0 0 0.3 1.57 0 0 hokuyo_link hokuyo_sensor_link" />
</launch>
  