<launch>
  <node pkg="move_base" type="move_base" name="move_base" output="screen">
    <param name="base_global_planner" value="navfn/NavfnROS"/>
    <param name="base_local_planner" value="base_local_planner/TrajectoryPlannerROS"/>
    <rosparam file="$(find iq_sim)/config/costmap_common_params.yaml" command="load"/>
    <rosparam file="$(find iq_sim)/config/local_costmap_params.yaml" command="load"/>
    <rosparam file="$(find iq_sim)/config/global_costmap_params.yaml" command="load"/>
  </node>
</launch>
